# --- Browser / Vite (public at build time; embedded in client bundles) ---
# NestJS API root used by the browser API client (Stage 1).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Server-only (Vercel project env; never use VITE_ prefix) ---
# BFF server functions only. `API_BASE_URL` must include `/api/v1` and use HTTPS in production.
# `MENYA_BFF_SHARED_SECRET` must match the NestJS `MENYA_BFF_SHARED_SECRET`.
# `SITE_ORIGIN` must match the deployed frontend origin exactly (scheme + host + port).
# Local dev also accepts loopback/LAN/WSL hosts on the same port (e.g. http://172.30.x.x:3000).
API_BASE_URL=http://localhost:4000/api/v1
SITE_ORIGIN=http://localhost:3000
# Vite dev uses port 3000 (see vite.config.ts server.strictPort).
MENYA_BFF_SHARED_SECRET=replace-with-at-least-32-characters-random-string
WEB_SESSION_COOKIE_NAME=mm_session

# --- Google sign-in (server-only on NestJS; frontend discovers via BFF status) ---
# Configure GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET on the NestJS host.
# Register redirect URI: {SITE_ORIGIN}/auth/google/callback

# --- Password reset delivery (NestJS) ---
# FRONTEND_SITE_ORIGIN should match SITE_ORIGIN above.
# SMTP_* and/or TWILIO_* on NestJS; AUTH_EXPOSE_RESET_TOKEN=false in production.